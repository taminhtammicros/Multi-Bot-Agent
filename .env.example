HOST=127.0.0.1
PORT=3890
DATABASE_URL=postgres://hub:hub_local_dev@127.0.0.1:55439/zalo_hub
# Local development default only. Use a random hexadecimal password for Docker deployments.
POSTGRES_PASSWORD=hub_local_dev
POSTGRES_PORT=55439
APP_PORT=3890
APP_BIND_ADDRESS=127.0.0.1
# Leave empty for a generated local administrator token (stored in data/admin-token).
ADMIN_TOKEN=
# Generate with: openssl rand -hex 32. If empty, generated in data/encryption-key.
ENCRYPTION_KEY=
# Optional loopback CDP endpoint. For a remote VPS Brave, forward its CDP port
# over SSH to this local port before attaching Teams Personal.
TEAMS_CDP_ENDPOINT=http://127.0.0.1:9222
